# DarkIntel runs IntelForge and VoidHawk in-process from this directory, so
# ONE .env here (copy this to .env and fill it in) covers all three: IntelForge
# reads its own INTELFORGE_* vars, VoidHawk reads its own (unprefixed) vars,
# Dragon reads DARKINTEL_*. No prefix collisions — safe to share one file.

# ─── Minimum to run anything (shared by IntelForge + VoidHawk) ────────────────
# Groq has a free tier and is what both projects default to.
GROQ_API_KEY=""

# ─── IntelForge (recon stage) ──────────────────────────────────────────────────
INTELFORGE_LLM_CLEANER="groq:llama-3.1-8b-instant"
INTELFORGE_LLM_ANALYST="groq:llama-3.3-70b-versatile"
INTELFORGE_LLM_RESEARCHER="groq:deepseek-r1-distill-llama-70b"

# ─── VoidHawk (scan/exploit/validate stage) ────────────────────────────────────
GROQ_MODEL_NAME="llama-3.3-70b-versatile"
VALIDATOR_ENABLED=true
VALIDATOR_CONFIDENCE_THRESHOLD=70
MEMORY_ENABLED=true
MEMORY_AGENT_DB_PATH="data/watchtower_memory.db"
MEMORY_DB_PATH="data/watchtower_memory.db"
MEMORY_VECTOR_ENABLED=true
MEMORY_VECTOR_DB_PATH="data/watchtower_vectordb"
CLEANER_ENABLED=true
CLEANER_USE_LLM=true

# ─── Dragon (opt-in — leave DARKINTEL_LLM_DRAGON unset to skip this stage) ────
# DARKINTEL_LLM_DRAGON="anthropic:claude-opus-4-..."
# ANTHROPIC_API_KEY=""
